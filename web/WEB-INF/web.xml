<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="          https://jakarta.ee/xml/ns/jakartaee          https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>com.mplads.servlet.RegistrationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.mplads.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Zoneprojectservlet</servlet-name>
        <servlet-class>com.mplads.servlet.Zoneprojectservlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ZoneProjectServlet</servlet-name>
        <servlet-class>com.mplads.servlet.ZoneProjectServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ZoneCountServlet</servlet-name>
        <servlet-class>com.mplads.servlet.ZoneCountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/RegistrationServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Zoneprojectservlet</servlet-name>
        <url-pattern>/Zoneprojectservlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ZoneProjectServlet</servlet-name>
        <url-pattern>/ZoneProjectServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ZoneCountServlet</servlet-name>
        <url-pattern>/ZoneCountServlet</url-pattern>
    </servlet-mapping>
</web-app>
